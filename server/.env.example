# HTTP listen port (default 3000)
PORT=3000

# JWT signing secret — MUST be overridden in production
JWT_SECRET=dev-secret-change-me

# MOCK_AI=1 replaces every AI/LLM call with a deterministic in-process script
# (no API key / no outbound requests / no model downloads) so the full COC
# flow — settings, story import/index, character creation, KP tool calls,
# save/load — can run without any external AI service. Used by the H5 E2E
# journey (`npm run test:e2e:h5`). Unset or 0 = normal mode (real providers).
# MOCK_AI=1

# Optional overrides (defaults shown):
# DATA_DIR=./data
# RAG_DATA_DIR=./data/rag
# UPLOADS_DIR=./uploads
# MODELS_DIR=./data/models
# MAX_UPLOAD_BYTES=52428800
